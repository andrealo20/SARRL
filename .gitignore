# Canonical retained evidence for the v1.9 adaptive nominal campaign.
!results/adaptive_nominal_v19/
!results/adaptive_nominal_v19/**

# Model checkpoints and context tensors are never committed. Their SHA-256
# fingerprints in the retained manifests preserve the identity of the exact
# models used to produce the evaluation records.
results/**/*.pt
results/**/*.npz
