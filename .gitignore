__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Root-level working notes, local launch scripts and local tool directories
# stay out of the repository.
/*.md
!/README.md
/*.ps1
/.*/
!/.github/
.venv/
venv/
build/
dist/
*.egg-info/
results/*
!results/.gitkeep
!results/v0_1_nominal.csv
!results/v0_9_baselines.csv
!results/v0_9_baselines.json

# Canonical retained evidence for the v1.2 planar ablation study.
!results/planar_ablations/
!results/planar_ablations/**

# Canonical retained evidence for the v1.3 OOD and fault campaign.
!results/ood_fault_robustness/
!results/ood_fault_robustness/**

# Canonical retained evidence for the v1.4 quantified-safety campaign.
!results/quantified_safety/
!results/quantified_safety/**

# Canonical retained evidence for v1.5 uncertainty-gate calibration. The
# uncompressed 100+ MiB transition table and resumable shards remain local;
# the deterministic gzip payload carries the same canonical CSV bytes.
!results/uncertainty_gate_calibration/
results/uncertainty_gate_calibration/*
!results/uncertainty_gate_calibration/phase_a/
results/uncertainty_gate_calibration/phase_a/*
!results/uncertainty_gate_calibration/phase_a/cells.csv
